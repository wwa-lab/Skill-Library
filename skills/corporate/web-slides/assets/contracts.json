        "maxItems": 12,
        "items": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1600
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 900
