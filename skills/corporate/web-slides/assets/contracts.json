{
  "brand": {
    "type": "object",
    "properties": {
      "schemaVersion": {
        "enum": [
          2
        ]
      },
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$",
        "maxLength": 64
      },
      "name": {
        "type": "string",
        "maxLength": 200
      },
      "accent": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{6}$",
        "maxLength": 6
      },
      "background": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{6}$",
        "maxLength": 6
      },
      "foreground": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{6}$",
        "maxLength": 6
      },
      "muted": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{6}$",
        "maxLength": 6
      },
      "fontFace": {
        "type": "string",
        "pattern": "^[A-Za-z0-9 㐀-鿿_-]{1,80}$",
        "maxLength": 80
      },
      "titleFontFace": {
        "type": "string",
        "pattern": "^[A-Za-z0-9 㐀-鿿_-]{1,80}$",
        "maxLength": 80
      },
      "preferredFonts": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[A-Za-z0-9 㐀-鿿_-]{1,80}$",
          "maxLength": 80
        },
        "minItems": 1,
        "maxItems": 6
      },
      "logo": {
        "type": [
          "string",
          "null"
        ],
        "maxLength": 40000000
      },
      "logoSlot": {
        "enum": [
          "local-approved-raster"
        ]
      },
      "logoBox": {
        "type": "object",
        "properties": {
          "x": {
            "type": "number",
            "minimum": 0,
            "maximum": 1600
          },
          "y": {
            "type": "number",
            "minimum": 0,
            "maximum": 900
          },
          "w": {
            "type": "number",
            "minimum": 1,
            "maximum": 1600
          },
          "h": {
            "type": "number",
            "minimum": 1,
            "maximum": 900
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h"
        ],
        "additionalProperties": false
      },
      "footer": {
        "type": "string",
        "maxLength": 200
      },
      "chartPalette": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{6}$",
          "maxLength": 6
        },
        "minItems": 1,
        "maxItems": 12
      },
      "allowedColors": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{6}$",
          "maxLength": 6
        },
        "minItems": 1,
        "maxItems": 12
      }
    },
    "required": [
      "schemaVersion",
      "id",
      "name",
      "accent",
      "background",
      "foreground",
      "muted",
      "fontFace",
      "titleFontFace",
      "preferredFonts",
      "logo",
      "logoSlot",
      "logoBox",
      "footer",
      "chartPalette",
      "allowedColors"
    ],
    "additionalProperties": false
  },
