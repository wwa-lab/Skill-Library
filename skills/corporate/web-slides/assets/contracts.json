  "paragraphs": {
    "type": "array",
    "minItems": 1,
    "maxItems": 50,
    "items": {
      "type": "object",
      "properties": {
        "align": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        },
        "list": {
          "enum": [
            "none",
            "bullet",
            "number"
          ]
        },
        "indent": {
          "enum": [
            0,
            1,
            2,
            3,
            4,
            5
          ]
        },
        "runs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "maxLength": 20000
              },
              "bold": {
                "enum": [
                  true,
                  false
                ]
              },
              "italic": {
                "enum": [
                  true,
                  false
                ]
              },
              "fontSize": {
                "type": "number",
                "minimum": 12,
                "maximum": 160
              },
              "color": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{6}$",
                "maxLength": 6
              },
              "hyperlink": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
